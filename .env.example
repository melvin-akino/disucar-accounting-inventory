# ── Database (Supabase PostgreSQL) ──────────────────────────────────────────
# Get these from: https://supabase.com/dashboard → project → Settings → Database
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/disucar?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/disucar"

# ── Supabase (Storage + Realtime) ──────────────────────────────────────────
# Get these from: Supabase dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL="https://[project-ref].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJ..."

# ── NextAuth ──────────────────────────────────────────────────────────────
# Generate secret: openssl rand -base64 32
NEXTAUTH_SECRET="your-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# Real production domain, no protocol (e.g. "ops.disucarsales.ph"). Required for
# Server Actions to work outside localhost — this includes the public QR
# order form. Leave as localhost:3000 for local development.
NEXT_PUBLIC_APP_ORIGIN="localhost:3000"

# ── App ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME="Disucar Sales ERP"
NEXT_PUBLIC_APP_ORG="Grocery & FMCG Distribution · PH"

# ── Branding (used across UI and all printed documents) ───────────────────
NEXT_PUBLIC_ORG_NAME="Disucar Sales Inc"
NEXT_PUBLIC_ORG_TAGLINE="Grocery & FMCG Distribution"
NEXT_PUBLIC_ORG_ADDRESS="3F Greenfield Tower, Mandaluyong City, Metro Manila 1550"
NEXT_PUBLIC_ORG_PHONE="+63 2 8123 4567"
NEXT_PUBLIC_ORG_EMAIL="info@disucarsales.ph"
NEXT_PUBLIC_ORG_TIN="123-456-789-000"
NEXT_PUBLIC_ORG_WEBSITE="www.disucarsales.ph"
NEXT_PUBLIC_ORG_COLOR="#003087"
# GitHub repo URL, used for the sidebar "Report a Bug" / "Request a Feature" links. Leave blank to hide them.
NEXT_PUBLIC_REPO_URL=""
NEXT_PUBLIC_ORG_RDO="044"
NEXT_PUBLIC_ORG_ZIP="1550"

# ── Email (Resend) ───────────────────────────────────────────────────────
# Optional. If unset, all outgoing email (order updates, invoice reminders,
# unbalanced collection notices) silently no-ops.
RESEND_API_KEY=""
EMAIL_FROM="Disucar Sales ERP <noreply@disucarsales.ph>"

# ── Cron ─────────────────────────────────────────────────────────────────
# Shared secret required in the "x-cron-secret" header to call /api/cron/*
# routes (e.g. the unbalanced-collections auto-issuance job). Generate with:
# openssl rand -base64 32
CRON_SECRET=""

# ── GPS / Fleet Tracking ────────────────────────────────────────────────
# Shared secret required in the "x-gps-secret" header to POST to
# /api/gps/ingest. Give this to whatever GPS/fleet-tracking provider is
# chosen — see DEPLOYMENT.md for the payload format. Generate with:
# openssl rand -base64 32
GPS_WEBHOOK_SECRET=""
