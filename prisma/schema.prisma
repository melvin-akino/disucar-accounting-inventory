generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Auth ────────────────────────────────────────────────────────────────────

enum Role {
  CUSTOMER
  AGENT
  FINANCE
  WAREHOUSE
  DRIVER
  ADMIN
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         Role     @default(AGENT)
  customerId   String?
  active       Boolean  @default(true)
  qrToken      String?  @unique
  homeWarehouseId String?
  isOwner      Boolean  @default(false)
  // Warehouse heads may create/manage reliever assignments (item 11), alongside Admin.
  isWarehouseHead Boolean @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  customer     Customer?    @relation(fields: [customerId],   references: [id])
  homeWarehouse Warehouse?  @relation(fields: [homeWarehouseId], references: [id])
  ordersPlaced Order[]      @relation("PlacedBy")
  orderEvents  OrderEvent[]
  journalEntries JournalEntry[]
  quotations   Quotation[]  @relation("QuoteAgent")
  attachments  Attachment[]
  quotaOverrides Order[]   @relation("QuotaOverrideBy")
  creditHoldOverrides Order[] @relation("CreditHoldOverrideBy")
  collections          Collection[] @relation("Collector")
  remittancesReceived  Collection[] @relation("RemittanceReceiver")
  vehiclesDriven       Vehicle[]
  customersAssigned    Customer[]   @relation("CustomerAssignedAgent")
  deliveryRunsAsDriver  DeliveryRun[] @relation("DeliveryRunDriver")
  deliveryRunsAsChecker DeliveryRun[] @relation("DeliveryRunCheckedBy")
  paymentsRecorded      Payment[]
  relieverAssignmentsAsOriginal RelieverAssignment[] @relation("RelieverOriginal")
  relieverAssignmentsAsReliever RelieverAssignment[] @relation("RelieverSubstitute")

  @@map("users")
}

// A temporary grant letting `relieverUser` cover `coveredRole`-gated actions for the
// [startDate, endDate] window (item 11). Scoped to Warehouse coverage in the current
// rollout; the coveredRole column keeps it extensible without a schema change.
model RelieverAssignment {
  id              String   @id @default(cuid())
  originalUserId  String
  relieverUserId  String
  coveredRole     Role
  startDate       DateTime
  endDate         DateTime
  notes           String?
  createdById     String?
  createdAt       DateTime @default(now())

  originalUser User @relation("RelieverOriginal", fields: [originalUserId], references: [id])
  relieverUser User @relation("RelieverSubstitute", fields: [relieverUserId], references: [id])

  @@map("reliever_assignments")
}

// ─── Customers ───────────────────────────────────────────────────────────────

model Customer {
  id           String   @id @default(cuid())
  code         String?  @unique
  name         String
  type         String   @default("SUPERMARKET")
  tin          String?
  region       String?
  city         String?
  terms        String   @default("Net 30")
  creditLimit  Decimal  @db.Decimal(14, 2) @default(0)
  contactEmail String?
  contactPhone String?
  source       String   @default("INTERNAL")
  assignedAgentId String?
  // Blanket discount % applied to every line when an order for this customer is set to
  // "Customer Blanket" discount mode (chosen on the order view by Finance/Admin).
  blanketDiscountPct Decimal? @db.Decimal(5, 2)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  users       User[]
  orders      Order[]
  invoices    Invoice[]
  quotations  Quotation[]
  quotas      CustomerQuota[]
  assignedAgent User? @relation("CustomerAssignedAgent", fields: [assignedAgentId], references: [id])

  @@map("customers")
}

// The two discount tiers a Finance/Admin can apply to a created order (order view):
// CUSTOMER = the customer's blanket % on every line; PRODUCT = a discretionary 1-3% per line.
enum DiscountMode {
  CUSTOMER
  PRODUCT
}

// ─── Suppliers ───────────────────────────────────────────────────────────────

enum SupplierStatus {
  ACTIVE
  ON_HOLD
  INACTIVE
}

model Supplier {
  id           String         @id @default(cuid())
  code         String?        @unique
  name         String
  contactEmail String?
  contactPhone String?
  city         String?
  terms        String         @default("Net 30")
  leadTimeDays Int            @default(7)
  rating       Decimal        @db.Decimal(3, 1) @default(4.5)
  status       SupplierStatus @default(ACTIVE)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  catalogItems CatalogItem[]
  inboundPOs   InboundPO[]
  bills        Bill[]

  @@map("suppliers")
}

// ─── Catalog ─────────────────────────────────────────────────────────────────

// Managed by catalog admins (see catalog/actions.ts createCategory/updateCategory/
// deleteCategory) rather than a fixed enum, so new product lines don't need a schema
// change. CatalogItem.category stores this code as plain text (soft reference — not a
// DB-level FK, so existing items keep their text even if the Category row is later
// renamed/deactivated); deleteCategory blocks while any CatalogItem still uses the code.
model Category {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("categories")
}

model CatalogItem {
  id         String       @id @default(cuid())
  sku        String       @unique
  name       String
  category   String       @default("OTHER")
  // Trading unit. Disucar sells by the case, so this is normally "case" and every quantity
  // in the system (stock, order lines, PO lines, lots) is denominated in it.
  unit       String       @default("pc")
  // Retail pieces contained in one `unit` (e.g. 48 cans per case). Informational only —
  // no conversion is applied, since buying and selling both happen in whole cases.
  unitsPerCase Int?
  // Retail selling price. Cost is never stored here — it varies per delivery and lives
  // on the Lot (see Phase 1 FIFO costing).
  unitPrice  Decimal      @db.Decimal(12, 2)
  // Wholesale selling price, one per SKU. Null means this item is not sold wholesale
  // and a wholesale order cannot include it.
  wholesalePrice Decimal? @db.Decimal(12, 2)
  // Minimum quantity of this SKU per line on a wholesale order. Null falls back to
  // OrgSettings.wholesaleDefaultMinQty.
  wholesaleMinQty Int?
  brand      String?
  imageUrl   String?
  active     Boolean      @default(true)
  supplierId String?
  // Self-relation grouping a piece-level SKU (unit: "pc") with its case-level sibling
  // for UI/reporting only — each row keeps its own independent Stock/Lot/price; there
  // is no automatic case<->piece stock conversion.
  parentId   String?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  supplier      Supplier?       @relation(fields: [supplierId], references: [id])
  parent        CatalogItem?    @relation("CaseToPiece", fields: [parentId], references: [id])
  variants      CatalogItem[]   @relation("CaseToPiece")
  orderLines    OrderLine[]
  stockRows     Stock[]
  stockMoves    StockMove[]
  inboundLines  InboundPOLine[]
  quotationLines QuotationLine[]
  returnLines   ReturnLine[]
  lots          Lot[]
  backorders    BackorderReturn[]

  @@map("catalog_items")
}

// ─── Warehouses ───────────────────────────────────────────────────────────────

model Warehouse {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  city      String?
  createdAt DateTime @default(now())

  orders        Order[]
  stock         Stock[]
  stockMoves    StockMove[]
  inboundPOs    InboundPO[]
  quotations    Quotation[]
  transfersFrom Transfer[] @relation("TransferFrom")
  transfersTo   Transfer[] @relation("TransferTo")
  lots          Lot[]
  backorders    BackorderReturn[]
  homeForUsers  User[]

  @@map("warehouses")
}

// ─── Sales Orders ─────────────────────────────────────────────────────────────

// Sales channel for an order. RETAIL is the pre-existing behaviour and stays the
// default; WHOLESALE prices from CatalogItem.wholesalePrice, enforces minimum
// quantities, and can only be approved by an ADMIN.
enum OrderChannel {
  RETAIL
  WHOLESALE
}

enum OrderState {
  PENDING
  APPROVED
  PREPARING
  SHIPPED
  DELIVERED
  CANCELLED
}

model Order {
  id          String      @id
  customerId  String
  agentId     String?
  warehouseId String
  state       OrderState  @default(PENDING)
  channel     OrderChannel @default(RETAIL)
  poRef       String?
  needBy      DateTime?
  cwt2307     Boolean     @default(false)
  subtotal    Decimal     @db.Decimal(14, 2)
  vat         Decimal     @db.Decimal(14, 2)
  cwt         Decimal     @db.Decimal(14, 2) @default(0)
  total       Decimal     @db.Decimal(14, 2)
  notes       String?
  msrCode     String?
  quotaOverride       Boolean   @default(false)
  quotaOverrideReason String?
  quotaOverrideById   String?
  quotaOverrideAt     DateTime?
  creditHoldOverride       Boolean   @default(false)
  creditHoldOverrideReason String?
  creditHoldOverrideById   String?
  creditHoldOverrideAt     DateTime?
  // Admin-only choice of which discount tier applied when this order was placed. Null
  // means no discount was configured/selected. Set once at creation for auditability.
  discountMode DiscountMode?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  customer    Customer    @relation(fields: [customerId],  references: [id])
  agent       User?       @relation("PlacedBy", fields: [agentId], references: [id])
  warehouse   Warehouse   @relation(fields: [warehouseId], references: [id])
  quotaOverrideBy User?  @relation("QuotaOverrideBy", fields: [quotaOverrideById], references: [id])
  creditHoldOverrideBy User? @relation("CreditHoldOverrideBy", fields: [creditHoldOverrideById], references: [id])
  lines       OrderLine[]
  events      OrderEvent[]
  shipment    Shipment?
  invoices    Invoice[]
  quotation   Quotation?
  returns     ReturnRequest[]
  deliveryStops DeliveryRunStop[]

  @@map("orders")
}

model OrderLine {
  id        String  @id @default(cuid())
  orderId   String
  skuId     String
  name      String
  unit      String
  qty       Int
  unitPrice Decimal @db.Decimal(12, 2)
  lineTotal Decimal @db.Decimal(12, 2)
  // Discount % applied to this line by Finance/Admin on the order view (blanket customer %
  // or a discretionary 1-3%). lineTotal already reflects it; null = no discount.
  discountPct Decimal? @db.Decimal(4, 2)
  isFree      Boolean  @default(false)

  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sku       CatalogItem @relation(fields: [skuId],   references: [id])
  lots      OrderLineLot[]

  @@map("order_lines")
}

model OrderEvent {
  id        String     @id @default(cuid())
  orderId   String
  state     String
  actorId   String?
  note      String?
  createdAt DateTime   @default(now())

  order     Order      @relation(fields: [orderId],  references: [id], onDelete: Cascade)
  actor     User?      @relation(fields: [actorId],  references: [id])

  @@map("order_events")
}

// ─── Shipments ────────────────────────────────────────────────────────────────

model Shipment {
  id           String    @id @default(cuid())
  orderId      String    @unique
  trackingNumber String?
  shippedAt    DateTime?
  eta          DateTime?
  podUrl       String?
  podSignedBy  String?
  vehicleId    String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  order        Order     @relation(fields: [orderId], references: [id])
  vehicle      Vehicle?  @relation(fields: [vehicleId], references: [id])

  @@map("shipments")
}

// ─── Delivery Runs (truck manifests) ─────────────────────────────────────────
// One truck run carries many orders/invoices — printed as a manifest before dispatch,
// reconciled stop-by-stop when the truck returns. Remarks here are a label only; they do
// not drive Order.state (that stays a separate, existing action elsewhere). A stop's
// collected amount is recorded through the existing Collections module, not a new ledger.

enum DeliveryRemark {
  DELIVERED
  STORE_CLOSED
  CANCELLED
}

model DeliveryRun {
  id          String   @id @default(cuid())
  runNumber   String   @unique
  driverId    String?
  vehicleId   String?
  helpers     String?
  runDate     DateTime
  checkedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  driver    User?    @relation("DeliveryRunDriver", fields: [driverId], references: [id])
  vehicle   Vehicle? @relation(fields: [vehicleId], references: [id])
  checkedBy User?    @relation("DeliveryRunCheckedBy", fields: [checkedById], references: [id])
  stops     DeliveryRunStop[]

  @@map("delivery_runs")
}

model DeliveryRunStop {
  id              String          @id @default(cuid())
  deliveryRunId   String
  orderId         String
  invoiceId       String?
  remark          DeliveryRemark?
  amountCollected Decimal?        @db.Decimal(14, 2)
  note            String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  deliveryRun DeliveryRun @relation(fields: [deliveryRunId], references: [id], onDelete: Cascade)
  order       Order       @relation(fields: [orderId], references: [id])
  invoice     Invoice?    @relation(fields: [invoiceId], references: [id])

  @@unique([deliveryRunId, orderId])
  @@map("delivery_run_stops")
}

// ─── Fleet / GPS Tracking ───────────────────────────────────────────────────────

model Vehicle {
  id               String    @id @default(cuid())
  plateNumber      String    @unique
  model            String?
  externalDeviceId String    @unique
  driverId         String?
  active           Boolean   @default(true)
  lastLat          Float?
  lastLng          Float?
  lastSpeedKph     Float?
  lastPingAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  driver           User?             @relation(fields: [driverId], references: [id])
  positions        VehiclePosition[]
  shipments        Shipment[]
  deliveryRuns     DeliveryRun[]

  @@map("vehicles")
}

model VehiclePosition {
  id         String   @id @default(cuid())
  vehicleId  String
  lat        Float
  lng        Float
  speedKph   Float?
  headingDeg Float?
  recordedAt DateTime
  receivedAt DateTime @default(now())

  vehicle    Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId, recordedAt])
  @@map("vehicle_positions")
}

// ─── Inventory ────────────────────────────────────────────────────────────────

model Stock {
  id          String   @id @default(cuid())
  skuId       String
  warehouseId String
  onHand      Int      @default(0)
  reserved    Int      @default(0)
  reorderAt   Int?
  maxLevel    Int?
  updatedAt   DateTime @updatedAt

  sku         CatalogItem @relation(fields: [skuId],       references: [id])
  warehouse   Warehouse   @relation(fields: [warehouseId], references: [id])

  @@unique([skuId, warehouseId])
  @@map("stock")
}

enum MoveType {
  RECEIPT
  PICK
  TRANSFER
  ADJUSTMENT
  RETURN
}

model StockMove {
  id          String   @id @default(cuid())
  skuId       String
  warehouseId String
  type        MoveType
  qty         Int
  costPerUnit Decimal  @db.Decimal(12, 2) @default(0)
  ref         String?
  note        String?
  by          String?
  at          DateTime @default(now())

  sku         CatalogItem @relation(fields: [skuId],       references: [id])
  warehouse   Warehouse   @relation(fields: [warehouseId], references: [id])

  @@map("stock_moves")
}

// ─── Inbound POs ──────────────────────────────────────────────────────────────

enum InboundStatus {
  EXPECTED
  RECEIVING
  RECEIVED
  DELAYED
}

model InboundPO {
  id          String        @id
  supplierId  String
  warehouseId String
  status      InboundStatus @default(EXPECTED)
  expectedAt  DateTime
  total       Decimal       @db.Decimal(14, 2)
  closedAt    DateTime?
  closedById  String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  supplier    Supplier      @relation(fields: [supplierId],  references: [id])
  warehouse   Warehouse     @relation(fields: [warehouseId], references: [id])
  lines       InboundPOLine[]
  lots        Lot[]
  backorders  BackorderReturn[]
  bills       Bill[]

  @@map("inbound_pos")
}

model InboundPOLine {
  id       String  @id @default(cuid())
  poId     String
  skuId    String
  qty      Int
  // Agreed cost per unit for this PO line. Previously collected on the create-PO form,
  // used to compute InboundPO.total and then discarded; it is now persisted because it
  // seeds Lot.unitCost when the PO is received.
  unitCost Decimal @default(0) @db.Decimal(12, 4)
  accepted Int     @default(0)
  damaged  Int     @default(0)

  po         InboundPO         @relation(fields: [poId],  references: [id], onDelete: Cascade)
  sku        CatalogItem       @relation(fields: [skuId], references: [id])
  backorders BackorderReturn[]

  @@map("inbound_po_lines")
}

// ─── Backorder (B.O.) Returns ──────────────────────────────────────────────────

enum BoDisposition {
  GOOD
  BAD
}

enum BoReasonType {
  RAT_BITE
  DAMAGED_CONTAINER
  EXPIRED
  WRONG_ITEM
  SHORT_SHIP
  OTHER
}

model BackorderReturn {
  id            String        @id @default(cuid())
  poId          String
  poLineId      String
  skuId         String
  warehouseId   String
  qty           Int
  costPerUnit   Decimal       @db.Decimal(12, 2)
  disposition   BoDisposition
  badReasonType BoReasonType?
  badReasonNote String?
  loggedById    String?
  loggedByName  String?
  createdAt     DateTime      @default(now())

  po        InboundPO     @relation(fields: [poId],     references: [id])
  poLine    InboundPOLine @relation(fields: [poLineId], references: [id])
  sku       CatalogItem   @relation(fields: [skuId],    references: [id])
  warehouse Warehouse     @relation(fields: [warehouseId], references: [id])

  @@map("backorder_returns")
}

// ─── Transfers ────────────────────────────────────────────────────────────────

enum TransferStatus {
  DRAFT
  IN_TRANSIT
  RECEIVED
}

model Transfer {
  id        String         @id
  fromId    String
  toId      String
  status    TransferStatus @default(DRAFT)
  eta       DateTime?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  from      Warehouse      @relation("TransferFrom", fields: [fromId], references: [id])
  to        Warehouse      @relation("TransferTo",   fields: [toId],   references: [id])
  lines     TransferLine[]

  @@map("transfers")
}

model TransferLine {
  id         String   @id @default(cuid())
  transferId String
  skuId      String
  qty        Int

  transfer   Transfer @relation(fields: [transferId], references: [id], onDelete: Cascade)

  @@map("transfer_lines")
}

// ─── Accounting ──────────────────────────────────────────────────────────────

enum JeSource {
  AR
  AP
  BANK
  PAYROLL
  INV
  GL
  OPENING
}

model JournalEntry {
  id         String    @id
  date       DateTime  @default(now())
  source     JeSource
  ref        String?
  memo       String
  postedById String?
  createdAt  DateTime  @default(now())

  postedBy   User?         @relation(fields: [postedById], references: [id])
  lines      JournalLine[]

  @@map("journal_entries")
}

model JournalLine {
  id    String @id @default(cuid())
  jeId  String
  code  String
  dr    Decimal @db.Decimal(14, 2) @default(0)
  cr    Decimal @db.Decimal(14, 2) @default(0)

  je    JournalEntry @relation(fields: [jeId], references: [id], onDelete: Cascade)

  @@map("journal_lines")
}

enum InvoiceStatus {
  DRAFT
  OPEN
  PARTIAL
  OVERDUE
  PAID
}

model Invoice {
  id         String        @id
  customerId String
  soId       String?
  issued     DateTime      @default(now())
  due        DateTime
  amount     Decimal       @db.Decimal(14, 2)
  paid       Decimal       @db.Decimal(14, 2) @default(0)
  status     InvoiceStatus @default(DRAFT)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  customer   Customer      @relation(fields: [customerId], references: [id])
  order      Order?        @relation(fields: [soId],       references: [id])
  collections Collection[]
  deliveryStops DeliveryRunStop[]
  payments    Payment[]

  @@map("invoices")
}

// ─── Field Collections / Remittances ───────────────────────────────────────────

enum CollectionStatus {
  PENDING   // collected, not yet remitted
  REMITTED  // fully remitted — balanced
  SHORT     // remitted less than collected — flagged discrepancy
}

model Collection {
  id              String           @id @default(cuid())
  employeeId      String
  invoiceId       String
  amountCollected Decimal          @db.Decimal(14, 2)
  collectedAt     DateTime         @default(now())
  amountRemitted  Decimal          @db.Decimal(14, 2) @default(0)
  remittedAt      DateTime?
  remittedById    String?
  status          CollectionStatus @default(PENDING)
  notes           String?
  shortageNote    String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  employee    User    @relation("Collector",         fields: [employeeId],   references: [id])
  remittedBy  User?   @relation("RemittanceReceiver", fields: [remittedById], references: [id])
  invoice     Invoice @relation(fields: [invoiceId],  references: [id])

  @@map("collections")
}

enum BillStatus {
  OPEN
  DUE
  PARTIAL
  OVERDUE
  PAID
}

model Bill {
  id         String     @id
  supplierId String?
  poId       String?
  vendor     String?
  ref        String?
  note       String?
  issued     DateTime   @default(now())
  due        DateTime
  amount     Decimal    @db.Decimal(14, 2)
  paid       Decimal    @db.Decimal(14, 2) @default(0)
  status     BillStatus @default(OPEN)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  supplier   Supplier?  @relation(fields: [supplierId], references: [id])
  po         InboundPO? @relation(fields: [poId], references: [id])
  payments   Payment[]

  @@map("bills")
}

enum PaymentType {
  CASH
  CHECK
  BANK_TRANSFER
  GCASH
  OTHER
}

// Additive metadata alongside recordInvoicePayment/recordBillPayment's existing JournalEntry
// write — the JE logic itself is unchanged; this just records how/when the payment moved.
model Payment {
  id           String      @id @default(cuid())
  invoiceId    String?
  billId       String?
  amount       Decimal     @db.Decimal(14, 2)
  paymentType  PaymentType
  bankName     String?
  transferDate DateTime?
  referenceNo  String?
  recordedById String
  createdAt    DateTime    @default(now())

  invoice      Invoice? @relation(fields: [invoiceId], references: [id])
  bill         Bill?    @relation(fields: [billId], references: [id])
  recordedBy   User     @relation(fields: [recordedById], references: [id])

  @@map("payments")
}

enum BirStatus {
  DUE
  FILED
  PENDING
}

model BirFiling {
  id     String    @id
  form   String
  period String
  desc   String
  due    DateTime
  amount Decimal   @db.Decimal(14, 2) @default(0)
  status BirStatus @default(PENDING)

  @@map("bir_filings")
}

// ─── Quotations / Proforma ────────────────────────────────────────────────────

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  CONVERTED
  EXPIRED
  REJECTED
}

model Quotation {
  id          String      @id
  customerId  String
  agentId     String?
  warehouseId String
  status      QuoteStatus @default(DRAFT)
  validUntil  DateTime
  notes       String?
  subtotal    Decimal     @db.Decimal(14, 2)
  vat         Decimal     @db.Decimal(14, 2)
  cwt         Decimal     @db.Decimal(14, 2) @default(0)
  cwt2307     Boolean     @default(false)
  total       Decimal     @db.Decimal(14, 2)
  orderId     String?     @unique
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  customer    Customer    @relation(fields: [customerId],   references: [id])
  agent       User?       @relation("QuoteAgent", fields: [agentId], references: [id])
  warehouse   Warehouse   @relation(fields: [warehouseId],  references: [id])
  lines       QuotationLine[]
  order       Order?      @relation(fields: [orderId],      references: [id])

  @@map("quotations")
}

model QuotationLine {
  id          String    @id @default(cuid())
  quotationId String
  skuId       String
  name        String
  unit        String
  qty         Int
  unitPrice   Decimal   @db.Decimal(12, 2)
  lineTotal   Decimal   @db.Decimal(12, 2)

  quotation   Quotation   @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  sku         CatalogItem @relation(fields: [skuId],       references: [id])

  @@map("quotation_lines")
}

// ─── Returns / RMA ───────────────────────────────────────────────────────────

enum ReturnStatus {
  REQUESTED
  APPROVED
  RECEIVED
  CLOSED
  REJECTED
}

enum Disposition {
  RESTOCK
  SCRAP
}

model ReturnRequest {
  id             String       @id
  orderId        String
  reason         String
  status         ReturnStatus @default(REQUESTED)
  notes          String?
  rejectedReason String?
  creditNoteRef  String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  order          Order        @relation(fields: [orderId], references: [id])
  lines          ReturnLine[]

  @@map("return_requests")
}

model ReturnLine {
  id               String      @id @default(cuid())
  returnId         String
  skuId            String
  name             String
  qtyRequested     Int
  qtyReceived      Int         @default(0)
  disposition      Disposition @default(RESTOCK)
  returnLotNumber  String?
  returnExpiryDate DateTime?

  returnReq    ReturnRequest @relation(fields: [returnId], references: [id], onDelete: Cascade)
  sku          CatalogItem   @relation(fields: [skuId],   references: [id])

  @@map("return_lines")
}

// ─── Lot / Batch Tracking ─────────────────────────────────────────────────────

enum LotStatus {
  ACTIVE
  QUARANTINED
  WRITTEN_OFF
}

model Lot {
  id             String    @id @default(cuid())
  lotNumber      String
  skuId          String
  warehouseId    String
  receivedQty    Int       @default(0)
  remainingQty   Int       @default(0)
  // Landed cost of one unit in THIS receipt. Cost varies per delivery (cement at 200
  // today, 205 next week), so it is stored on the lot rather than on the SKU — this is
  // the layer FIFO consumes and what COGS is computed from. 4 dp absorbs the rounding
  // of bulk costing (e.g. 7,000 over 18 m3 = 388.8889/m3).
  unitCost       Decimal   @default(0) @db.Decimal(12, 4)
  // Physical receipt time. FIFO orders by this, NOT by createdAt, so a backdated
  // receipt still consumes in the correct sequence.
  receivedAt     DateTime  @default(now())
  expiryDate     DateTime?
  poId           String?
  status         LotStatus @default(ACTIVE)
  writeOffNote   String?
  writeOffRef    String?
  quarantineNote String?
  createdAt      DateTime  @default(now())

  sku            CatalogItem  @relation(fields: [skuId],       references: [id])
  warehouse      Warehouse    @relation(fields: [warehouseId], references: [id])
  po             InboundPO?   @relation(fields: [poId],        references: [id])
  orderLineLots  OrderLineLot[]

  @@unique([lotNumber, skuId, warehouseId])
  // FIFO lookup: open layers for a SKU at a warehouse, oldest receipt first.
  @@index([skuId, warehouseId, receivedAt])
  @@map("lots")
}

// ─── Organisation Settings ────────────────────────────────────────────────────

model OrgSettings {
  id      String  @id @default("singleton")
  name    String
  tagline String
  address String
  phone   String
  email   String
  tin     String
  website String
  color   String
  rdo                String  @default("")
  zip                String  @default("")
  logoUrl            String?
  expiryWarnDays     Int     @default(90)
  expiryCriticalDays Int     @default(30)
  // Wholesale thresholds. Per-SKU CatalogItem.wholesaleMinQty overrides the qty default;
  // the order floor applies to the whole order regardless of SKU mix.
  wholesaleDefaultMinQty Int     @default(1)
  wholesaleMinOrderTotal Decimal @default(0) @db.Decimal(14, 2)
  allowedOfficeIps   String  @default("")

  @@map("org_settings")
}

// ─── File Attachments ─────────────────────────────────────────────────────────

model Attachment {
  id           String   @id @default(cuid())
  entityType   String
  entityId     String
  filename     String
  originalName String
  fileSize     Int
  mimeType     String
  url          String
  uploadedById String?
  uploadedAt   DateTime @default(now())

  uploadedBy   User?    @relation(fields: [uploadedById], references: [id])

  @@index([entityType, entityId])
  @@map("attachments")
}

// ─── FEFO Lot Allocation per Order Line ──────────────────────────────────────────

model OrderLineLot {
  id          String   @id @default(cuid())
  orderLineId String
  lotId       String
  qtyTaken    Int
  // Cost snapshot frozen at allocation time. Deliberately duplicated from Lot.unitCost:
  // a later correction to the lot must never retroactively rewrite a posted COGS entry.
  unitCost    Decimal  @default(0) @db.Decimal(12, 4)
  costTotal   Decimal  @default(0) @db.Decimal(14, 2)
  allocatedAt DateTime @default(now())

  orderLine   OrderLine @relation(fields: [orderLineId], references: [id], onDelete: Cascade)
  lot         Lot       @relation(fields: [lotId],       references: [id])

  @@map("order_line_lots")
}

// ─── Customer Purchase Quotas ─────────────────────────────────────────────────

model CustomerQuota {
  id           String   @id @default(cuid())
  customerId   String
  label        String
  periodStart  DateTime
  periodEnd    DateTime
  targetAmount Decimal  @db.Decimal(14, 2)
  notes        String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  customer     Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@map("customer_quotas")
}

// ── Generic Audit Log ─────────────────────────────────────────────────────────────
// Captures cross-cutting events not stored in domain tables:
// logins, settings saves, branding changes, user management.

model AuditLog {
  id         String   @id @default(cuid())
  action     String   // e.g. "user.login", "branding.save", "user.create"
  entityType String?  // e.g. "user", "branding"
  entityId   String?  // relevant entity ID
  actorId    String?  // user who performed the action
  actorName  String?  // denormalised — preserved if user is deleted
  meta       String?  // JSON blob of extra context
  at         DateTime @default(now())

  @@index([action])
  @@index([actorId])
  @@index([at])
  @@map("audit_logs")
}
